# Zugang zur Online-Rangliste (Supabase) – als .env.local kopieren und ausfüllen.
# .env.local wird nicht hochgeladen. Der „publishable“-Schlüssel ist öffentlich gedacht:
# die Datenbank lässt nur die Funktionen aus supabase/rangliste.sql zu.
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_dein-schluessel
